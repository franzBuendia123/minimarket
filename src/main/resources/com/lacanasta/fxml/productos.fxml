<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="module"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lacanasta.controller.ProductoController">

    <HBox alignment="BOTTOM_LEFT" spacing="12.0">
        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
            <Label text="GESTIÓN" styleClass="eyebrow"/>
            <Label text="Productos" styleClass="page-title"/>
            <Label text="Administra el catálogo, precios y disponibilidad." styleClass="page-description"/>
        </VBox>
        <Button text="Nuevo producto" onAction="#onNuevo" styleClass="btn, btn-primary"/>
    </HBox>

    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <HBox styleClass="card-header">
            <HBox styleClass="field" spacing="10.0" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label text="🔍" styleClass="field-icon"/>
                <TextField fx:id="txtBuscar" promptText="Buscar productos..." HBox.hgrow="ALWAYS" onAction="#onBuscar"/>
            </HBox>
        </HBox>

        <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
            <columnResizePolicy>

                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>

            </columnResizePolicy>

            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="120.0" minWidth="80.0" maxWidth="140.0"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="250.0"/>
                <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120.0" minWidth="80.0" maxWidth="150.0"/>
                <TableColumn fx:id="colPrecioNormal" text="Precio" prefWidth="90.0" minWidth="80.0" maxWidth="120.0"/>
                <TableColumn fx:id="colPrecioDescuento" text="Descuento" prefWidth="90.0" minWidth="80.0" maxWidth="120.0"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="80.0" minWidth="80.0" maxWidth="100.0"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="90.0" minWidth="80.0" maxWidth="100.0"/>
                <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="200.0" minWidth="200.0" maxWidth="200.0"/>
            </columns>
        </TableView>

        <HBox styleClass="pagination" alignment="CENTER_LEFT">
            <Label fx:id="lblPagina" text="Página 1 de 1" styleClass="result-count"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAnterior" text="Anterior" onAction="#onAnterior" styleClass="btn, btn-outline"/>
            <Button fx:id="btnSiguiente" text="Siguiente" onAction="#onSiguiente" styleClass="btn, btn-outline"/>
        </HBox>
    </VBox>

</VBox>
