<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<GridPane hgap="10.0" vgap="12.0" styleClass="card, form-grid"
          xmlns="http://javafx.com/javafx/21"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.lacanasta.controller.ProveedorFormController">

    <Label text="Nombre:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="txtNombre" styleClass="field" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="240.0"/>

    <Label text="Contacto:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="txtContacto" styleClass="field" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Teléfono:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="txtTelefono" styleClass="field" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Dirección:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextField fx:id="txtDireccion" styleClass="field" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <HBox spacing="15" alignment="CENTER_RIGHT" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2">
        <Button text="Cancelar" onAction="#onCancelar" prefWidth="120" styleClass="btn, btn-outline"/>
        <Button text="Guardar" onAction="#onGuardar" prefWidth="120" styleClass="btn, btn-primary"/>
    </HBox>

</GridPane>
