<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="module"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lacanasta.controller.VentaController">

    <fx:define>
        <ToggleGroup fx:id="grupoPago"/>
    </fx:define>

    <VBox spacing="3.0">
        <Label text="PUNTO DE VENTA" styleClass="eyebrow"/>
        <Label text="Nueva venta" styleClass="page-title"/>
        <Label text="Busca productos, arma el pedido y completa el cobro." styleClass="page-description"/>
    </VBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <HBox styleClass="card-header">
                <VBox spacing="2.0">
                    <Label text="Productos disponibles" styleClass="card-title"/>
                    <Label text="Catálogo en tiempo real" styleClass="card-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Stock en vivo" styleClass="badge, badge-info"/>
            </HBox>

            <HBox styleClass="field" spacing="10.0" alignment="CENTER_LEFT">
                <Label text="🔍" styleClass="field-icon"/>
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre o escanear código..." HBox.hgrow="ALWAYS" onAction="#onBuscar"/>
            </HBox>

            <TableView fx:id="tablaResultados" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colNombreResultado" text="Producto" prefWidth="250.0"/>
                    <TableColumn fx:id="colStockResultado" text="Stock" prefWidth="90.0" minWidth="80.0" maxWidth="120.0"/>
                    <TableColumn fx:id="colPrecioResultado" text="Precio" prefWidth="90.0" minWidth="80.0" maxWidth="120.0"/>
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="140.0" minWidth="140.0" maxWidth="140.0"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="card" prefWidth="430.0" VBox.vgrow="ALWAYS">
            <HBox styleClass="card-header, cart-title">
                <VBox spacing="2.0">
                    <Label text="Detalle de venta" styleClass="card-title"/>
                    <Label fx:id="lblUnidades" text="0 unidades" styleClass="card-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Vaciar" onAction="#onVaciar" styleClass="btn, btn-danger"/>
            </HBox>

            <ListView fx:id="lstCarrito" VBox.vgrow="ALWAYS"/>

            <VBox spacing="9.0" styleClass="cart-summary">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Total" styleClass="form-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotal" text="S/ 0.00" styleClass="summary-total"/>
                </HBox>

                <Label text="Método de pago" styleClass="form-label"/>

                <HBox spacing="6.0">
                    <ToggleButton fx:id="btnEfectivo" text="Efectivo" toggleGroup="$grupoPago" onAction="#onMetodoEfectivo" styleClass="payment-option" prefWidth="100" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <ToggleButton fx:id="btnTarjeta" text="Tarjeta" toggleGroup="$grupoPago" onAction="#onMetodoTarjeta" styleClass="payment-option" prefWidth="100" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <ToggleButton fx:id="btnYape" text="Yape / Plin" toggleGroup="$grupoPago" onAction="#onMetodoYape" styleClass="payment-option" prefWidth="100" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>

                <VBox fx:id="panelEfectivo" spacing="9.0">
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Label text="Monto recibido" styleClass="form-label"/>
                        <TextField fx:id="txtMontoRecibido" promptText="0.00" styleClass="field" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="lblVuelto" text="Vuelto: S/ 0.00" styleClass="change-box" maxWidth="Infinity"/>
                </VBox>

                <Button fx:id="btnPagar" text="Cobrar" onAction="#onPagar" styleClass="btn, btn-primary" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </HBox>

</VBox>
