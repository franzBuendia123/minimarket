<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="login-root" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.lacanasta.controller.LoginController">

    <VBox styleClass="login-card" alignment="CENTER" spacing="16.0" prefWidth="400.0" maxWidth="400.0">
        <ImageView fx:id="imgLogo" fitWidth="240.0" preserveRatio="true"/>
        <Label text="Iniciar sesión" styleClass="login-subtitle"/>

        <HBox styleClass="field" spacing="10.0" alignment="CENTER_LEFT">
            <Label text="👤" styleClass="field-icon"/>
            <TextField fx:id="txtUsuario" promptText="Usuario" HBox.hgrow="ALWAYS"/>
        </HBox>

        <HBox styleClass="field" spacing="10.0" alignment="CENTER_LEFT">
            <Label text="🔒" styleClass="field-icon"/>
            <PasswordField fx:id="txtContrasena" promptText="Contraseña" HBox.hgrow="ALWAYS"/>
            <Label text="👁" styleClass="field-icon"/>
        </HBox>

        <Label fx:id="lblError" styleClass="error-label" visible="false"/>

        <Button text="Ingresar" onAction="#onLogin" defaultButton="true" styleClass="login-button" maxWidth="Infinity"/>
    </VBox>

</StackPane>
