<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="module"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lacanasta.controller.CompraController">

    <HBox alignment="BOTTOM_LEFT" spacing="12.0">
        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
            <Label text="ABASTECIMIENTO" styleClass="eyebrow"/>
            <Label text="Registrar compra" styleClass="page-title"/>
            <Label text="Registra mercadería entrante y actualiza tu inventario." styleClass="page-description"/>
        </VBox>
        <Button text="Registrar compra" onAction="#onRegistrarCompra" styleClass="btn, btn-primary"/>
    </HBox>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <HBox styleClass="card-header">
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="Productos disponibles" styleClass="card-title"/>
                    <Label text="Catálogo en tiempo real" styleClass="card-subtitle"/>
                </VBox>
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Proveedor:" styleClass="form-label"/>
                    <ComboBox fx:id="cmbProveedor" prefWidth="200.0"/>
                </HBox>
            </HBox>
            <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colNombreProd" text="Producto" prefWidth="250.0"/>
                    <TableColumn fx:id="colStockProd" text="Stock" prefWidth="80.0" minWidth="80.0" maxWidth="100.0"/>
                    <TableColumn fx:id="colPrecioProd" text="Precio" prefWidth="80.0" minWidth="80.0" maxWidth="120.0"/>
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="140.0" minWidth="140.0" maxWidth="140.0"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="card" prefWidth="430.0" VBox.vgrow="ALWAYS">
            <HBox styleClass="card-header">
                <VBox spacing="2.0">
                    <Label text="Detalle de compra" styleClass="card-title"/>
                    <Label fx:id="lblTotal" text="Total: S/ 0.00" styleClass="card-subtitle"/>
                </VBox>
            </HBox>
            <ListView fx:id="lstDetalle" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>

</VBox>
